# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=default

# Tavily Web Search API
TAVILY_API_KEY=tvly-your-api-key-here

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20250929-v1:0
AGENT_NAME=job-connector-agent

# Optional: Enable contact caching (Memory primitive)
ENABLE_CONTACT_CACHE=false
DYNAMODB_TABLE_NAME=job-connector-hr-contacts

# Optional: Serper API (fallback for Tavily)
SERPER_API_KEY=

# Search Configuration
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT_SECONDS=30

# Development/Testing
DEBUG=false
LOG_LEVEL=INFO
